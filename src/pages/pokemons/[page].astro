---
import type { GetStaticPaths } from 'astro';
import type {PokemonListResponse} from '../../interfaces/pokemon-list'
import PokemonCard from '../../components/pokemos/PokemonCard.astro'

import MainLayout from "../../layouts/MainLayout.astro"



export const getStaticPaths = ( async ( {paginate} ) => {
	const resp = await fetch('https://pokeapi.co/api/v2/pokemon/?limit=151');
	const {results} = (await resp.json()) as PokemonListResponse;
	
	return paginate(results, { pageSize: 15});
}) satisfies GetStaticPaths;


const title = 'Pokemon Astro'
const { page } = Astro.props;


---






<MainLayout title={title}>
	<h1 class="text-5xl text-center m-4 capitalize">Listado Pokemons</h1>
	<hr class="m-8">

	<section arial-label="Listado de Pokemons" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5 ">
		{page.data.map(({name, url }) =>
			<PokemonCard {name} {url} />)}		
		</section>

		<section class="flex mt-10 gap-2 items-center">

			
			<a class:list={
				["btn", {
					disable: !page.url.prev
				}]
			} href={page.url.prev}>Anterior</a>


<a class:list={
	["btn", {
		disable: !page.url.next
	}]
} href={page.url.next}>Siguiente</a>



<div class="flex flex-1"></div>

	<span class="text-xl font-bold">Pagina #{page.currentPage}</span>

	
</section>
</MainLayout>

<style>
	.btn {
		@apply bg-[#10173f] p-2 text-white rounded-md
	}

	.disable {
		@apply  bg-slate-900 text-gray-400
	}
</style>